<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>White to Black on Refresh</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
            font-family: Arial, sans-serif;
            transition: background-color 0.3s ease;
        }
        .message {
            text-align: center;
            padding: 24px;
            border-radius: 12px;
            background: rgba(0,0,0,0.2);
        }
    </style>
</head>
<body>
    <div class="message">
        <h1>Page color changes on refresh</h1>
        <p>Reload the page to switch the background between white and black.</p>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const currentColor = localStorage.getItem('pageColor');
            const body = document.body;

            if (!currentColor || currentColor === 'black') {
                body.style.backgroundColor = '#ffffff';
                body.style.color = '#000000';
                localStorage.setItem('pageColor', 'white');
            } else {
                body.style.backgroundColor = '#000000';
                body.style.color = '#ffffff';
                localStorage.setItem('pageColor', 'black');
            }
        });
    </script>
</body>
</html>